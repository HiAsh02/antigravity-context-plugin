{
  "command": "node",
  "args": ["--watch", "main.mjs"],
  "restart_policy": "always",
  "display_name": "Context Monitor",
  "description": "实时查看当前会话（Session）的上下文窗口占用、剩余容量、缓存命中率、结构拆解与历史趋势。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Context",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Context"
      }
    ]
  }
}
